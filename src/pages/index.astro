---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    icon: '💊',
    title: 'Wide range',
    desc: 'Over 10,000 SKUs across 100+ trusted pharmaceutical brands.',
  },
  {
    icon: '🚚',
    title: 'Fast dispatch',
    desc: 'Same-day delivery across metro Bengaluru, next-day across the state.',
  },
  {
    icon: '💰',
    title: 'Trade pricing',
    desc: 'Competitive slabs for sub-stockists, chemists and hospitals.',
  },
  {
    icon: '🤝',
    title: 'Three decades',
    desc: 'Serving 1,000+ trade partners with precision since 1991.',
  },
];

const trustBrands = ['Cipla', 'Glenmark', 'Cadila', 'Intas', 'Torrent', 'Wockhardt'];

const brands = [
  'Alembic',
  'B-tex',
  'Bentley',
  'Biochem',
  'Biocrross',
  'Cadila',
  'Cipla',
  'Delux',
  'Enkay',
  'Glenmark',
  'HMD',
  'Hicks',
  'Intas',
  'JMS',
  'Kremoint',
  'Medifill',
  'Microlabs',
  'National',
  'Omega',
  'Saibol',
  'Torrent',
  'Wockhardt',
];

const bigStats = [
  { n: '1991', suf: '', label: 'Established', sub: 'Three decades of pharmaceutical distribution from Bengaluru.' },
  { n: '1,000', suf: '+', label: 'Trade partners', sub: 'Sub-stockists, chemists and hospitals across South India.' },
  { n: '100', suf: '+', label: 'Brands stocked', sub: 'Premium pharmaceutical manufacturers, on a single ledger.' },
  { n: '10,000', suf: '+', label: 'SKUs in catalog', sub: 'From OTC and antibiotics to specialty therapy areas.' },
];
---

<Layout title="Home">
  <!-- =================== HERO =================== -->
  <section class="hero-section">
    <div class="grid-background"></div>
    <div class="container hero-container">
      <div class="hero-left">
        <span class="eyebrow hero-eyebrow"><span class="num">PLA / 01</span>Pharma Links Agencies &middot; Bengaluru</span>
        <h1 class="hero-title">
          Healthcare,<br /><em class="serif-accent">delivered.</em>
        </h1>
        <p class="hero-subtitle">
          A pharmaceutical distribution network built for the trade &mdash; sub-stockists, chemists and
          hospitals across Karnataka and beyond.
        </p>
        <p class="hero-desc mono">Powered by Pharma Links Agencies infrastructure &middot; Since 1991</p>

        <div class="hero-cta-group">
          <a href="https://pharmalinks.co.in/" target="_blank" rel="noopener" class="btn btn-primary">
            Place an order <span aria-hidden="true">→</span>
          </a>
          <a href="/contact" class="btn btn-outline">Talk to us</a>
        </div>

        <div class="micro-trust">
          <div class="stat"><span class="n mono">1,000+</span><span>Trade partners</span></div>
          <div class="divider"></div>
          <div class="stat"><span class="n mono">100+</span><span>Brands stocked</span></div>
          <div class="divider"></div>
          <div class="stat"><span class="n mono">Since 1991</span><span>Bengaluru-based</span></div>
        </div>
      </div>

      <div class="hero-right">
        <div class="js-slider" id="heroSlider">
          <img src="/banners/hero_banner_1.png" class="slide-img active" alt="Slide 1" />
          <img src="/banners/hero_banner_2.png" class="slide-img" alt="Slide 2" />
          <img src="/banners/hero_banner_3.png" class="slide-img" alt="Slide 3" />
          <img src="/banners/hero_banner_4.png" class="slide-img" alt="Slide 4" />
        </div>

        <div class="floating-badge badge-1">
          <span class="lbl">Inventory</span>
          <span class="val mono">10,000+ SKUs</span>
        </div>
        <div class="floating-badge badge-2">
          <span class="lbl">Network</span>
          <span class="val mono">1,000+ partners</span>
        </div>
        <div class="floating-badge badge-3">
          <span class="lbl">On-time</span>
          <span class="val mono">98.4%</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =================== TRUST STRIP =================== -->
  <section class="trust-strip">
    <div class="container trust-strip-row">
      <div class="trust-lbl">Trusted by 100+ pharmaceutical manufacturers across India</div>
      <div class="trust-logos">
        {trustBrands.map((b) => <span class="lg">{b}</span>)}
      </div>
    </div>
  </section>

  <!-- =================== BIG NUMBERS =================== -->
  <section class="big-numbers-section">
    <div class="container">
      <div class="big-numbers">
        {bigStats.map((s) => (
          <div class="cell">
            <div class="n">{s.n}<span class="suf">{s.suf}</span></div>
            <div class="l">{s.label}</div>
            <div class="sub">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =================== WHY US =================== -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="sec-eyebrow"><span class="num">01</span>Why partner with us</span>
          <h2>Distribution as a <em class="serif-accent">discipline</em>,<br />not a side job.</h2>
        </div>
        <p class="sec-tag">
          We move medicine across Karnataka the same way every day &mdash; sharp inventory, accurate
          paperwork, and dispatch you can plan around.
        </p>
      </div>
      <div class="features-grid">
        {features.map((f) => (
          <div class="feature-card-modern">
            <div class="icon-wrapper">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =================== BRANDS =================== -->
  <section class="section brands-showcase">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="sec-eyebrow"><span class="num">02</span>Our partners</span>
          <h2>The <em class="serif-accent">shelf,</em><br />stocked deep.</h2>
        </div>
        <p class="sec-tag">
          From legacy generics to specialty brands &mdash; we carry the medicines your customers ask for
          by name.
        </p>
      </div>

      <div class="brands-row-container">
        <div class="brands-scroll-row">
          {brands.map((brand, index) => (
            <div class="brand-item" style={`animation-delay: ${index * 0.08}s`}>
              <div class="brand-item-content">
                <img
                  src={`/brands/${brand}.png`}
                  alt={brand}
                  loading="lazy"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                />
                <div class="fallback-badge" style="display:none">{brand[0]}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="brands-cta-row">
        <a href="/brands" class="view-all-link">
          <span>View all brands</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- =================== ABOUT =================== -->
  <section class="section">
    <div class="container about-grid-modern">
      <div class="about-img_modern">
        <img src="/building.jpg" alt="Pharma Links Agencies office, Bengaluru" />
        <div class="about-overlay">
          <span class="mono ov-tag">Bengaluru &middot; HQ</span>
          <h3>Since 1991</h3>
        </div>
      </div>
      <div class="about-content_modern">
        <span class="sec-eyebrow"><span class="num">03</span>About us</span>
        <h2>A working tool for the <em class="serif-accent">trade.</em></h2>
        <p class="lead">Building the future of healthcare logistics in South India.</p>
        <p>
          Pharma Links Agencies isn't a brochure-ware distributor &mdash; we're a vital node in the
          healthcare ecosystem. Three decades of relationships with manufacturers, three decades of
          last-mile delivery to chemists and hospitals.
        </p>
        <a href="/about" class="btn btn-dark mt-4">Read our story <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- =================== FINAL CTA =================== -->
  <section class="final-cta">
    <div class="container final-cta-inner">
      <h3>Stock the <em class="serif-accent">right</em> brands.<br />Move them on time.</h3>
      <div class="final-cta-actions">
        <a href="/contact" class="btn btn-white">Talk to us <span aria-hidden="true">→</span></a>
        <a href="https://pharmalinks.co.in/" target="_blank" rel="noopener" class="btn btn-ghost-white">
          Place an order
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===================== HERO ===================== */
  .hero-section {
    position: relative;
    padding: 6rem 0 5rem;
    overflow: hidden;
    background-color: #fff;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .grid-background {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 0;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-eyebrow {
    margin-bottom: 28px;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 500;
    line-height: 0.98;
    margin: 0 0 1.5rem;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .hero-title em.serif-accent {
    font-size: 1.08em;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    font-weight: 400;
    margin: 0 0 1.25rem;
    color: var(--text-2);
    line-height: 1.55;
    max-width: 44ch;
  }

  .hero-desc {
    color: var(--text-3);
    margin: 0 0 2rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
  }

  .hero-cta-group {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* Micro-trust strip under CTAs */
  .micro-trust {
    display: flex;
    gap: 24px;
    align-items: center;
    margin-top: 56px;
    font-size: 12px;
    color: var(--text-2);
    flex-wrap: wrap;
  }

  .micro-trust .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .micro-trust .stat .n {
    font-weight: 600;
    color: var(--ink);
    font-size: 14px;
    letter-spacing: -0.01em;
  }

  .micro-trust .divider {
    width: 1px;
    height: 28px;
    background: var(--line-2);
  }

  /* Hero visual side */
  .hero-right {
    position: relative;
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 70% 40%, rgba(211, 47, 47, 0.08), transparent 55%),
      var(--bg-cream);
    border-radius: 24px;
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .js-slider {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide-img {
    position: absolute;
    max-width: 80%;
    max-height: 80%;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
  }

  .slide-img.active {
    opacity: 1;
    transform: scale(1);
    z-index: 2;
  }

  .floating-badge {
    position: absolute;
    background: #fff;
    padding: 12px 14px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.12), 0 2px 4px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 3;
    animation: float 6s ease-in-out infinite;
  }

  .floating-badge .lbl {
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-2);
    font-weight: 600;
  }

  .floating-badge .val {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .badge-1 {
    top: 8%;
    right: 6%;
    transform: rotate(2deg);
    animation-delay: 0s;
  }

  .badge-2 {
    bottom: 14%;
    left: 4%;
    transform: rotate(-3deg);
    animation-delay: 1.5s;
  }

  .badge-3 {
    top: 48%;
    right: 4%;
    transform: rotate(-1deg);
    animation-delay: 3s;
  }

  @keyframes float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }

  /* ===================== TRUST STRIP ===================== */
  .trust-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
    padding: 28px 0;
  }

  .trust-strip-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .trust-lbl {
    font-size: 12px;
    color: var(--text-2);
    max-width: 26ch;
    line-height: 1.4;
  }

  .trust-logos {
    display: flex;
    gap: 36px;
    flex-wrap: wrap;
    align-items: center;
    opacity: 0.7;
    filter: grayscale(1);
  }

  .trust-logos .lg {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--text);
    font-style: italic;
    letter-spacing: -0.01em;
  }

  /* ===================== BIG NUMBERS ===================== */
  .big-numbers-section {
    padding: 4rem 0 0;
  }

  .big-numbers {
    background: var(--ink);
    color: #fff;
    border-radius: 20px;
    padding: 56px 48px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .big-numbers .cell {
    padding: 0 32px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  .big-numbers .cell:first-child {
    padding-left: 0;
  }

  .big-numbers .cell:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .big-numbers .n {
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .big-numbers .n .suf {
    font-size: 0.45em;
    color: var(--brand-red);
    margin-left: 4px;
    vertical-align: super;
    font-weight: 600;
  }

  .big-numbers .l {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .big-numbers .sub {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 8px;
    line-height: 1.45;
    max-width: 22ch;
  }

  /* ===================== FEATURES ===================== */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .feature-card-modern {
    padding: 28px;
    border: 1px solid var(--line-2);
    border-radius: 16px;
    background: #fff;
    transition: border-color 0.18s var(--ease-out), transform 0.32s var(--ease-out),
      box-shadow 0.32s var(--ease-out);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 200px;
  }

  .feature-card-modern:hover {
    border-color: var(--ink);
  }

  .feature-card-modern h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .feature-card-modern p {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.55;
    margin: 0;
  }

  .icon-wrapper {
    width: 44px;
    height: 44px;
    background: var(--brand-red-soft);
    color: var(--brand-red);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    border-radius: 12px;
  }

  /* ===================== BRANDS ===================== */
  .brands-showcase {
    background: var(--bg-soft);
  }

  .brands-row-container {
    overflow: hidden;
    position: relative;
    margin: 2rem 0;
  }

  .brands-scroll-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.5rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
  }

  .brands-scroll-row::-webkit-scrollbar {
    height: 4px;
  }

  .brands-scroll-row::-webkit-scrollbar-thumb {
    background: var(--line-2);
    border-radius: 10px;
  }

  .brand-item {
    flex-shrink: 0;
    animation: slideInLeft 0.6s var(--ease-out) backwards;
  }

  @keyframes slideInLeft {
    from { opacity: 0; transform: translate3d(-20px, 0, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  .brand-item-content {
    background: #fff;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 110px;
    min-width: 160px;
    transition: border-color 0.18s var(--ease-out), transform 0.32s var(--ease-out),
      box-shadow 0.32s var(--ease-out);
  }

  .brand-item:hover .brand-item-content {
    border-color: var(--ink);
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.06);
  }

  .brand-item-content img {
    max-width: 100%;
    max-height: 70px;
    object-fit: contain;
    filter: grayscale(0.6);
    transition: filter 0.32s var(--ease-out);
  }

  .brand-item:hover .brand-item-content img {
    filter: grayscale(0);
  }

  .fallback-badge {
    width: 60px;
    height: 60px;
    background: var(--brand-red-soft);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--brand-red);
    font-size: 1.6rem;
  }

  .brands-cta-row {
    text-align: center;
    padding-top: 1rem;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    padding: 10px 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    transition: border-color 0.18s var(--ease-out), gap 0.18s var(--ease-out);
  }

  .view-all-link:hover {
    border-color: var(--ink);
    gap: 12px;
  }

  /* ===================== ABOUT ===================== */
  .about-grid-modern {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .about-img_modern {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .about-img_modern img {
    width: 100%;
    display: block;
    filter: grayscale(20%);
    transition: filter 0.4s var(--ease-out);
  }

  .about-img_modern:hover img {
    filter: grayscale(0);
  }

  .about-overlay {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background: #fff;
    padding: 16px 20px;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .about-overlay .ov-tag {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    font-weight: 600;
  }

  .about-overlay h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .about-content_modern h2 {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 600;
    color: var(--ink);
    margin: 16px 0 12px;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .about-content_modern .lead {
    font-size: 1.1rem;
    color: var(--text);
    margin: 0 0 12px;
    line-height: 1.5;
  }

  .about-content_modern p {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.6;
    margin: 0;
  }

  .about-content_modern .btn {
    margin-top: 24px;
  }

  /* ===================== FINAL CTA ===================== */
  .final-cta {
    background: var(--brand-red);
    color: #fff;
    padding: 100px 0;
    position: relative;
    overflow: hidden;
    margin-top: 6rem;
  }

  .final-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.1), transparent 30%),
      radial-gradient(circle at 80% 80%, rgba(0, 0, 0, 0.15), transparent 30%);
    pointer-events: none;
  }

  .final-cta-inner {
    position: relative;
    text-align: center;
  }

  .final-cta h3 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-family: var(--font-sans);
    font-weight: 500;
    max-width: 18ch;
    margin-inline: auto;
    color: #fff;
  }

  .final-cta h3 em.serif-accent {
    color: #fff;
  }

  .final-cta-actions {
    margin-top: 40px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-white {
